{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard.css",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard.js",
      "use": "@vercel/static"
    },
    {
      "src": "tokderlogo.png",
      "use": "@vercel/static"
    },
    {
      "src": "assets/TikTok_dark.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/TikTok_light.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/facebook-icon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/instagram-icon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "assets/youtube.svg",
      "use": "@vercel/static"
    },
    {
      "src": "harian/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/harian",
      "destination": "/harian/index.html"
    },
    {
      "source": "/harian/",
      "destination": "/harian/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/scan/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
